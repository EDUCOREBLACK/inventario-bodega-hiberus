PORT=5001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:5173

# Development-only emergency authentication bypass. Keep false in shared or production environments.
ALLOW_LOCAL_AUTH=false

# Database maintenance flags. Both are destructive and must only be enabled for an approved migration.
RESET_LEGACY_INVENTORY=false
CLEANUP_LEGACY_TABLES=false